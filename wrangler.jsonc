{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Wrangler's esbuild `keep-names` injects a `__name()` helper into bundled
  // functions. Libraries that serialise functions to strings (next-themes)
  // then ship `__name(...)` to the browser, where it is undefined.
  // https://opennext.js.org/cloudflare/howtos/keep_names
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding. Must match "name" above.
      // https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "btc"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
